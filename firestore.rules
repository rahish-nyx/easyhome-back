rules_version = '2';

// EasyHome Firestore rules.
// Reads are served directly to the PWA (realtime + offline cache).
// Writes are ONLY performed by the Express API using the Admin SDK,
// which bypasses these rules. Clients can never write.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isApprovedWorker() {
      return signedIn() && request.auth.token.workerApproved == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function booking(id) {
      return get(/databases/$(database)/documents/bookings/$(id)).data;
    }

    // ---- Public catalogue (safe for guests, cacheable) ----
    match /services/{serviceId} {
      allow read: if true;
    }
    match /cities/{cityId} {
      allow read: if true;
    }
    match /promos/{promoId} {
      allow read: if true;
    }
    match /settings/{docId} {
      allow read: if true;
    }
    match /workersPublic/{workerId} {
      allow read: if true;
    }
    match /urgentPublic/{jobId} {
      allow read: if true;
    }
    match /reviews/{reviewId} {
      allow read: if true;
    }

    // ---- Private profiles ----
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
    }
    match /workers/{uid} {
      allow read: if isOwner(uid) || isAdmin();
    }

    // ---- Bookings ----
    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || (signedIn() && resource.data.workerId == request.auth.uid);

      match /private/{documentId} {
        allow read: if isAdmin()
          || (signedIn() && booking(bookingId).customerId == request.auth.uid)
          || (
            signedIn()
            && booking(bookingId).workerId == request.auth.uid
            && booking(bookingId).pricing.confirmedAt != null
          );
      }

      match /events/{eventId} {
        allow read: if isAdmin()
          || (signedIn() && booking(bookingId).customerId == request.auth.uid)
          || (signedIn() && booking(bookingId).workerId == request.auth.uid);
      }
    }

    // ---- Worker job feed (approved workers only) ----
    match /jobFeed/{jobId} {
      allow read: if isAdmin() || isApprovedWorker();
    }

    // ---- Notifications ----
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ---- Money ----
    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }
    match /commissions/{commissionId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.workerId == request.auth.uid);
    }

    // ---- Support chat ----
    match /chatThreads/{uid} {
      allow read: if isAdmin() || isOwner(uid);

      match /messages/{messageId} {
        allow read: if isAdmin() || isOwner(uid);
      }
    }

    // ---- Admin metadata ----
    match /admins/{uid} {
      allow read: if isAdmin() || isOwner(uid);
    }
    match /audit/{auditId} {
      allow read: if isAdmin();
    }

    // Default deny (writes everywhere).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
