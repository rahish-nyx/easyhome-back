# ============================================================
# EasyHome API - environment
# Copy this file to `.env` and fill in your Firebase credentials.
# NEVER commit `.env`.
# ============================================================

NODE_ENV=development
PORT=5000

# --- Web clients allowed to call this API (comma separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://easyhome-bec14.web.app
PUBLIC_WEB_URL=http://localhost:5173

# --- Firebase Admin service account -------------------------
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
# Then either set GOOGLE_APPLICATION_CREDENTIALS to the downloaded JSON file,
# or paste the three values from it below, or provide the full JSON.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Cloudinary image storage (required for uploads) -----------
# Provide either CLOUDINARY_URL or all three explicit values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@<cloud-name>

# Optional alternative to a key file:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# ============================================================
# Local development with the Firebase Emulator Suite
# (see README). When these are set, no service account is needed.
# ============================================================
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Transactional email (optional) --------------------------
# Without these, in-app notifications still work; emails are skipped.
RESEND_API_KEY=
MAIL_FROM="EasyHome <official.easyhomeservices@gmail.com>"

# --- Seed / bootstrap ---------------------------------------
# Used by `npm run seed` to create the first admin account.
# Set a unique password of at least 12 characters before the first seed.
# If this is blank or too short, the seed skips the admin account.
ADMIN_EMAIL=official.easyhomeservices@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=EasyHome Admin

# --- Business rules ------------------------------------------
DEFAULT_COMMISSION_PCT=10
DEFAULT_SUBSCRIPTION_PRICE=199

# --- Razorpay (automated subscriptions + commission) ---------
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay Dashboard webhook URL:
# https://<your-domain>/api/payment/webhook
# Events: payment.captured and order.paid

# --- Telegram admin alerts (optional) -------------------------
# Create a bot with @BotFather, send it a message, then read the chat id.
# Alerts are skipped safely when either value is empty.
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
