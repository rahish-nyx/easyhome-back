# EasyHome Backend — production Vercel env
NODE_ENV=production
PORT=5000

# MongoDB Atlas (standard non-SRV URI)
MONGODB_URI=mongodb://officialeasyhomeservices_db_user:k5uM4P4mplSwE4Gd@easyhome-shard-00-00.xxxxx.mongodb.net:27017,easyhome-shard-00-01.xxxxx.mongodb.net:27017/easyhome?replicaSet=atlas-xxxx-shard-0&ssl=true&authSource=admin

# JWT
JWT_SECRET=easyhome-prod-secret-change-me-immediately
JWT_EXPIRES_IN=30d

# Web / CORS
CORS_ORIGINS=https://easyhome-front.vercel.app,http://localhost:5173
PUBLIC_WEB_URL=https://easyhome-front.vercel.app

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email / notifications (optional, for production)
RESEND_API_KEY=your-resend-api-key
MAIL_FROM="EasyHome <onboarding@resend.dev>"
ADMIN_EMAIL=official.easyhomeservices@gmail.com
