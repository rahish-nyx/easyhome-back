# EasyHome Backend — production Vercel env
NODE_ENV=production
PORT=5000

MONGODB_URI=mongodb://... (your Atlas URI)
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=30d

CORS_ORIGINS=https://easyhome-front.vercel.app,http://localhost:5173
PUBLIC_WEB_URL=https://easyhome-front.vercel.app

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=c0534a001@smtp-brevo.com
SMTP_PASSWORD=your-brevo-smtp-password
MAIL_FROM=EasyHome <official.easyhomeservices@gmail.com>

ADMIN_EMAIL=official.easyhomeservices@gmail.com
