# ==========================================
# EasyHome Backend Environment Configuration
# COPY THIS FILE TO .env AND FILL IN YOUR SECRETS
# NEVER COMMIT .env TO GITHUB!
# ==========================================

PORT=5000

# MongoDB Connection String (Atlas or Local)
# Replace <username>, <password>, <cluster> with your details
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/easyhome?retryWrites=true&w=majority

# Strong Cryptographic Secret for JWT Tokens (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_super_strong_random_jwt_secret_here

# SMTP / Email Service Configuration (Google App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_google_app_password

# Initial Admin Credentials (used only once if no admin exists)
ADMIN_EMAIL=admin@easyhome.com
ADMIN_PASSWORD=change_this_to_a_strong_admin_password

# UPI ID for manual subscriptions
ADMIN_UPI=admin@easyhome.upi

# Security flag: set to false in production to prevent OTP disclosure
DEMO_OTP_FALLBACK=false
